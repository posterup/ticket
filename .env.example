# Copy to .env.local for local dev, and set these in Vercel → Project → Settings
# → Environment Variables for production. Never commit real secrets.

# SMS. Pick an operator: kavenegar | smsir
# Unset auto-selects whichever set of credentials is present, preferring
# Kavenegar. Order confirmations go to the buyer and to the event's owners
# and admins; one-time codes go through the operator's approved template.
SMS_PROVIDER=

# Kavenegar (https://kavenegar.com)
KAVENEGAR_API_KEY=
# Optional; omit to use the account's default sender line.
KAVENEGAR_SENDER=
# Approved template name for one-time codes.
KAVENEGAR_OTP_TEMPLATE=

# sms.ir SMS gateway (https://sms.ir)
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

# Feature flags (see lib/flags.ts). Set to 1 to enable; unset/anything else = off.
# Calendar (تقویمی / recurring) scheduling — hidden site-wide while off.
NEXT_PUBLIC_CALENDAR_MODE=

# Database (Prisma Postgres — see README)
# The pooled connection string. This is what the app runs on.
DATABASE_URL=
# The *direct* (unpooled) connection string, used only by `prisma migrate`.
# Neon and the Vercel Postgres integration both set this name for you.
#
# Not optional in production, despite the fallback in `prisma.config.ts`: DDL
# depends on session state — advisory locks, SET, prepared statements — that a
# pooler in transaction mode does not keep. Migrating through the pooled URL
# fails, or half-applies and leaves the schema in a state no later migration
# expects. Leave this blank only for a plain local Postgres, which has no
# pooler in front of it.
DATABASE_URL_UNPOOLED=

# Uploads (Vercel Blob). Posters and images are uploaded from the browser
# straight to Blob, so the token signs those client uploads.
# Vercel injects this automatically once a Blob store is linked to the project
# (Storage → Blob → Connect). Set it by hand only outside Vercel.
BLOB_READ_WRITE_TOKEN=

# Auth
# Peppers the one-time-code hashes. Generate with: openssl rand -base64 32
AUTH_SECRET=
# sms.ir verify/pattern template for OTPs. Without it, development prints the
# code to the server console instead of sending it.
SMSIR_OTP_TEMPLATE_ID=

# Payments
# mock (settles in-process, no credentials) | zarinpal-sandbox | zarinpal
# Unset falls back to the mock in development only — a production build refuses
# to start a checkout without an explicit choice here, because the mock hands
# out paid tickets for free.
PAYMENT_PROVIDER=
ZARINPAL_MERCHANT_ID=
# Absolute origin the gateway returns buyers to. Defaults to the request origin.
APP_URL=

# Vercel Blob — posters and ticket artwork.
# Set automatically by the Blob integration on Vercel. Locally, `vercel env
# pull` or paste the token from the store's page; without it `/api/uploads`
# cannot mint a token and every image upload fails with a Persian error rather
# than silently doing nothing.
BLOB_READ_WRITE_TOKEN=
